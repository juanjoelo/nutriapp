{
  "name": "nutriapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/optimize-images.js",
    "dev": "node scripts/dev.js",
    "inspect": "npm run build && node scripts/inspect.js",
    "prebuild": "node scripts/optimize-images.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "pretest": "node scripts/optimize-images.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "owner:invite": "node --env-file-if-exists=.env scripts/invite-owner.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-supabase.js",
    "test:postgres": "node scripts/test-postgres.js"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.0",
    "vite": "^7.1.0"
  }
}

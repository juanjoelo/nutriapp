# Copy to .env locally. Never commit credentials.
NODE_ENV=development
PORT=4100
HOST=127.0.0.1
APP_URL=http://localhost:5173
DATA_DIR=./data
# Local development defaults. For cloud use "supabase" in both providers.
DATABASE_PROVIDER=sqlite
DATABASE_URL=
# Optional path to the Supabase database CA certificate. TLS verification stays enabled.
DATABASE_CA_CERT=
STORAGE_PROVIDER=local
SUPABASE_URL=
# Server-only secret key (or legacy service_role key); never VITE_*.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=nutriapp-products
# Single owner: administration, sales and password recovery.
OWNER_EMAIL=nutrivaninaalaniz@gmail.com
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# OAuth application configuration (server only). Owner authorizes from /admin > Pagos.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# 32 random bytes as 64 hex characters. Keep stable and back up securely with the DB.
PAYMENT_ENCRYPTION_KEY=
# Optional legacy credentials; leave empty when using owner OAuth.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
MP_LIVE_MODE=false
# Integration credentials issued by Correo, not the MiCorreo password.
CORREO_API_USER=
CORREO_API_PASSWORD=
CORREO_CUSTOMER_ID=
CORREO_ENV=test
SHIPPING_ORIGIN_POSTAL_CODE=5881
PACKAGING_WEIGHT_GRAMS=100
TRUST_PROXY_HOPS=0
# Optional IP-country suggestion through a trusted edge. Minimum 32 random characters.
# Edge must overwrite cf-ipcountry and x-nutriapp-edge-key; see docs/PAGOS_INTERNACIONALES.md.
COUNTRY_EDGE_KEY=
